{
  "name": "cscout-vscode",
  "displayName": "CScout",
  "publisher": "cscout",
  "icon": "logo.png",
  "description": "VS Code interface for the CScout C source code analyzer",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/cscout-project/cscout-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "workspaceContains:**/*.c"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cscout.start",
        "title": "CScout: Start Analysis",
        "icon": "$(play)"
      },
      {
        "command": "cscout.stop",
        "title": "CScout: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cscout.reanalyze",
        "title": "CScout: Re-analyze",
        "icon": "$(sync)"
      },
      {
        "command": "cscout.toggle",
        "title": "CScout: Toggle Start/Stop"
      },
      {
        "command": "cscout.showWalkthrough",
        "title": "CScout: Getting Started"
      },
      {
        "command": "cscout.refresh",
        "title": "CScout: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "cscout.showFunctionMetrics",
        "title": "CScout: Show Function Metrics"
      },
      {
        "command": "cscout.showFileMetricsAggregate",
        "title": "CScout: Show File Metrics Table"
      },
      {
        "command": "cscout.showFunMetricsAggregate",
        "title": "CScout: Show Function Metrics Table"
      },
      {
        "command": "cscout.showIdentifierStats",
        "title": "CScout: Show Identifier Statistics"
      },
      {
        "command": "cscout.inspectFile",
        "title": "CScout: Inspect File Details",
        "icon": "$(search)"
      },
      {
        "command": "cscout.showCallGraph",
        "title": "CScout: Show Call Graph"
      },
      {
        "command": "cscout.loadMore",
        "title": "CScout: Load More"
      },
      {
        "command": "cscout.findReferences",
        "title": "CScout: Find References"
      },
      {
        "command": "cscout.rename",
        "title": "CScout: Rename Symbol"
      },
      {
        "command": "cscout.showFileDep",
        "title": "CScout: Show File Dependency Graph"
      },
      {
        "command": "cscout.inspect",
        "title": "CScout: Inspect Identifier"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cscout",
          "title": "CScout",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "cscout": [
        {
          "id": "cscout.actions",
          "name": "Control Panel"
        },
        {
          "id": "cscout.identifiers",
          "name": "Identifiers"
        },
        {
          "id": "cscout.files",
          "name": "Files"
        },
        {
          "id": "cscout.functions",
          "name": "Functions"
        },
        {
          "id": "cscout.filedeps",
          "name": "File Dependencies"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "cscout.refresh",
          "when": "false"
        },
        {
          "command": "cscout.showFunctionMetrics",
          "when": "false"
        },
        {
          "command": "cscout.showFileMetricsAggregate",
          "when": "false"
        },
        {
          "command": "cscout.showFunMetricsAggregate",
          "when": "false"
        },
        {
          "command": "cscout.showIdentifierStats",
          "when": "false"
        },
        {
          "command": "cscout.inspectFile",
          "when": "false"
        },
        {
          "command": "cscout.showCallGraph",
          "when": "false"
        },
        {
          "command": "cscout.loadMore",
          "when": "false"
        },
        {
          "command": "cscout.findReferences",
          "when": "false"
        },
        {
          "command": "cscout.rename",
          "when": "false"
        },
        {
          "command": "cscout.showFileDep",
          "when": "false"
        },
        {
          "command": "cscout.inspect",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "cscout.inspectFile",
          "when": "viewItem == cscoutFile",
          "group": "inline"
        },
        {
          "command": "cscout.inspectFile",
          "when": "viewItem == cscoutFile",
          "group": "cscout@1"
        }
      ]
    },
    "configuration": {
      "title": "CScout",
      "properties": {
        "cscout.binaryPath": {
          "type": "string",
          "default": "cscout",
          "description": "Required. Path to the CScout binary (resolved via PATH on Linux/macOS; full path required on Windows)."
        },
        "cscout.cscocoPyPath": {
          "type": "string",
          "default": "",
          "description": "Optional override. Path to cscoco.py. If left blank, directly derived from the CScout binary path."
        },
        "cscout.csapiPyPath": {
          "type": "string",
          "default": "",
          "description": "Optional override. Path to csapi.py. If left blank, directly derived from the CScout binary path."
        },
        "cscout.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Required. Path to your Python 3 interpreter."
        },
        "cscout.sqlite3Path": {
          "type": "string",
          "default": "sqlite3",
          "description": "Required. Path to the sqlite3 command-line tool, used to build the analysis database."
        },
        "cscout.host": {
          "type": "string",
          "default": "localhost",
          "description": "CScout API server hostname. Usually fine to leave as-is."
        },
        "cscout.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the csapi.py server. Leave as 0 to pick an available port automatically (recommended), or set a specific number (e.g. 8081) to force a static port."
        },
        "cscout.csmakePath": {
          "type": "string",
          "default": "",
          "description": "Optional override. Path to the csmake tool. If left blank, directly derived from the CScout binary path."
        },
        "cscout.projectName": {
          "type": "string",
          "description": "Optional. Overrides the project name shown in the UI (defaults to the workspace folder name)."
        },
        "cscout.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Optional. Automatically start CScout analysis when a C workspace is opened."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "node out/test.js",
    "test-e2e": "CSCOUT_PATH=\"${CSCOUT_PATH:-../cscout}\" && python3 \"$CSCOUT_PATH/src/csapi.py\" \"$CSCOUT_PATH/example/awk.db\" -p 8081 & PID=$!; sleep 2; npm run compile && node out/test-e2e.js; kill -9 $PID"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0"
  }
}